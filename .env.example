# Copy this file to .env and fill in local values. Do not commit .env.

# PostgreSQL — local or managed (Neon/Railway/Supabase). Never commit real passwords.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/wholesale_db

# Required in production. Use a long random string (32+ chars).
JWT_SECRET=change_me_to_a_long_random_string

PORT=3000
NODE_ENV=development

# Optional Gemini key for AI chat / STT / TTS (commerce works without it; keep server-side only)
# GEMINI_API_KEY=
# GEMINI_LIVE_AUDIO_TEST=1
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_FALLBACK_MODELS=gemini-3.8-flash

# Development seed accounts only. Never used when NODE_ENV=production.
SEED_ADMIN_EMAIL=admin@market.pk
SEED_ADMIN_PASSWORD=admin123
SEED_WHOLESALER_PASSWORD=password123
SEED_CLIENT_PASSWORD=password123
SEED_CLIENT_PHONE=03009876543
SEED_DELIVERY_EMAIL=delivery@market.pk
SEED_DELIVERY_PASSWORD=delivery123

# Production: create the first admin only if no admin exists (min 12 chars, not a demo password)
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_PASSWORD=

# Public HTTPS site URL used in password-reset / invitation links (no trailing slash)
APP_BASE_URL=http://127.0.0.1:3000

# Comma-separated browser origins allowed to call the API (Vercel frontend URL(s))
# CORS_ORIGINS=https://your-app.vercel.app,https://your-app-git-mahad-development.vercel.app

# Transactional email — local default is console (logs only).
# MAIL_MODE=console|smtp|disabled
# MAIL_DRY_RUN=1 forces no network SMTP (tests / safe preview)
MAIL_MODE=console
MAIL_FROM="Peshawar Wholesale OS <noreply@wholesale.local>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Email worker: omit or "inline" on persistent Node hosts; "external" when using cron only
# EMAIL_WORKER_MODE=inline
# CRON_SECRET=

# Persistent voice upload directory (Railway/Render volume). Defaults to ./uploads/voice
# VOICE_UPLOAD_ROOT=/data/voice
