# Copy this file to .env and fill in local values. Do not commit .env.

# PostgreSQL 17 local connection. Replace YOUR_PASSWORD locally; do not commit .env.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/wholesale_db

# Required in production. Any non-default value is fine for local development.
JWT_SECRET=change_me_to_a_long_random_string

PORT=3000

# Optional Gemini key for AI chat / STT / TTS (commerce works without it)
# GEMINI_API_KEY=
# Opt-in only — do not enable while free-tier quota is exhausted:
# GEMINI_LIVE_AUDIO_TEST=1
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_FALLBACK_MODELS=gemini-3.8-flash

# Development seed accounts only. These defaults match the existing demo UI.
# Override them locally; they are never used when NODE_ENV=production.
SEED_ADMIN_EMAIL=admin@market.pk
SEED_ADMIN_PASSWORD=admin123
SEED_WHOLESALER_PASSWORD=password123
SEED_CLIENT_PASSWORD=password123
SEED_CLIENT_PHONE=03009876543
SEED_DELIVERY_EMAIL=delivery@market.pk
SEED_DELIVERY_PASSWORD=delivery123
