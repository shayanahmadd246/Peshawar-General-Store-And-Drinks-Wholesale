{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "tsx --test tests/auth.test.ts tests/auth.integration.test.ts tests/commerce.integration.test.ts tests/fulfillment.integration.test.ts tests/ai.integration.test.ts tests/voice.unit.test.ts tests/voice.integration.test.ts",
    "test:auth": "tsx --test tests/auth.test.ts tests/auth.integration.test.ts",
    "test:commerce": "tsx --test tests/commerce.integration.test.ts",
    "test:fulfillment": "tsx --test tests/fulfillment.integration.test.ts",
    "test:ai": "tsx --test tests/ai.integration.test.ts",
    "test:voice": "tsx --test tests/voice.unit.test.ts tests/voice.integration.test.ts",
    "smoke:ai": "node scripts/ai-smoke.mjs",
    "smoke:voice": "node scripts/voice-smoke.mjs",
    "demo:e2e": "node scripts/demo-e2e.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
